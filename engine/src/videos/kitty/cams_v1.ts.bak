// Camera keys and lens blur per shot for the Acoustic Kitty short (cameras mostly on +z looking -z: +x = screen right).
import { C } from "./cues";
import { SHOTS, Key, Shot, V3, fr, runKeys, pushK, dolly, applyKick, KICKS, Cam, glide, FPS } from "./story";

const S = (id: number) => SHOTS[id - 1].a;
const F = fr;
type DKey = { f: number; dur?: number; cInf: number; focus?: (f: number) => V3 };
const CAMS: Record<number, Key[]> = {}, DOF: Record<number, DKey[]> = {};
const def = (id: number, keys: Key[], dof: DKey[]) => { CAMS[id] = keys; DOF[id] = dof; };
const D = (pos: V3, look: V3, f0: number, fov = 42, rate = 0.0022, extra: Partial<Cam> = {}, punch = 0) => (f: number) => dolly(pos, look, pushK(f, f0, rate, punch, 30), { fov, ...extra });
const X = (f: number, s: (f: number) => Shot): Key => ({ f, cut: true, s });
const foc = (p: V3) => () => p;

// 1 HQ: the brilliant idea
def(1, [{ f: S(1), s: D([0.3, 1.6, 2.4], [0, 1.6, -2.5], S(1), 42, 0.0022) }], [{ f: S(1), cInf: 6, focus: foc([0, 1.6, -2.5]) }]);
// 2 "Cats."
def(2, [{ f: S(2), s: D([0.3, 1.12, 0.05], [0.1, 1.05, -1.5], S(2), 40, 0.0025, {}, 0.008) }], [{ f: S(2), cInf: 13, focus: foc([0.1, 1.05, -1.5]) }]);
// 3 park bench: nobody suspects a cat -> it listens
def(3, [{ f: S(3), s: D([0.4, 1.9, 0.6], [0.35, 0.8, -6], S(3), 42, 0.0022) }, X(F(C.listening) - 2, D([1.05, 0.8, -4.7], [1.2, 0.72, -6.0], F(C.listening), 38, 0.003, {}, 0.006))],
  [{ f: S(3), cInf: 6, focus: foc([0.3, 0.9, -6]) }, { f: F(C.listening) - 2, cInf: 13, focus: foc([1.2, 0.72, -6]) }]);
// 4 the vet
def(4, [{ f: S(4), s: D([0.15, 1.6, 3.4], [0.05, 1.35, -1.8], S(4), 42, 0.0022) }], [{ f: S(4), cInf: 6, focus: foc([0, 1.2, -1.6]) }]);
// 5 the gear goes in
def(5, [{ f: S(5), s: D([0.18, 1.22, 0.0], [0, 1.15, -1.4], S(5), 38, 0.002) }], [{ f: S(5), cInf: 13, focus: foc([0, 1.15, -1.4]) }]);
// 6 Agent Kitty is ready (low hero angle)
def(6, [{ f: S(6), s: D([0.45, 0.95, 0.2], [0, 1.28, -1.4], S(6), 42, 0.003, {}, 0.007) }], [{ f: S(6), cInf: 10, focus: foc([0, 1.2, -1.4]) }]);
// 7 one problem -> it's a cat
def(7, [{ f: S(7), s: D([0.15, 1.6, 3.4], [0.05, 1.35, -1.8], S(7), 42, 0.0022) }, X(F(C.its6) - 2, D([0.15, 1.2, -0.15], [0, 1.15, -1.4], F(C.its6), 36, 0.003, {}, 0.006))],
  [{ f: S(7), cInf: 6, focus: foc([0, 1.2, -1.6]) }, { f: F(C.its6) - 2, cInf: 13, focus: foc([0, 1.15, -1.4]) }]);
// 8 training: wanders off -> food
def(8, [{ f: S(8), s: D([-0.3, 1.35, 6.6], [-0.5, 0.85, 1.8], S(8), 44, 0.002) }, X(F(C.food) - 2, D([4.85, 0.62, 3.5], [4.75, 0.35, 1.95], F(C.food), 40, 0.003, {}, 0.006))],
  [{ f: S(8), cInf: 4, focus: foc([0, 0.8, 1.8]) }, { f: F(C.food) - 2, cInf: 12, focus: foc([4.75, 0.35, 1.95]) }]);
// 9 the second operation
def(9, [{ f: S(9), s: D([0.15, 1.6, 3.4], [0.05, 1.35, -1.8], S(9), 42, 0.0022) }, X(F(C.second) - 2, D([0.18, 1.22, 0.0], [0, 1.12, -1.4], F(C.second), 38, 0.0025, {}, 0.006))],
  [{ f: S(9), cInf: 6, focus: foc([0, 1.2, -1.6]) }, { f: F(C.second) - 2, cInf: 13, focus: foc([0, 1.1, -1.4]) }]);
// 10 the first real mission: crane down onto the team
def(10, [{ f: S(10), s: D([4, 7, 15], [0, 2.6, -10], S(10), 46, 0.001) }, { f: S(10) + 6, dur: Math.max(24, F(C.mission) - S(10) + 6), s: D([0.2, 1.3, 7.6], [-1.0, 1.0, 2.4], F(C.mission), 44, 0.002) }],
  [{ f: S(10), cInf: 0 }, { f: F(C.mission), dur: 12, cInf: 5, focus: foc([-1.2, 1.0, 2.8]) }]);
// 11 two men on a bench -> the Soviet building behind
def(11, [{ f: S(11), s: D([0.5, 1.35, -2.6], [0.3, 1.05, -6], S(11), 40, 0.002) }, { f: F(C.outside) - 4, dur: 36, s: D([0.4, 1.3, 0.6], [0.3, 3.6, -14], F(C.outside), 48, 0.0015) }],
  [{ f: S(11), cInf: 8, focus: foc([0.3, 1.0, -6]) }, { f: F(C.outside) - 4, dur: 30, cInf: 0 }]);
// 12 release the cat (side view from +x: screen right = -z)
def(12, [{ f: S(12), s: D([2.8, 0.95, 1.9], [-1.0, 0.75, 1.95], S(12), 46, 0.002) }], [{ f: S(12), cInf: 5, focus: foc([-1.0, 0.6, 2.0]) }]);
// 13 depends on who you ask
def(13, [{ f: S(13), s: D([1.5, 0.85, 0.75], [-0.9, 0.75, 0.75], S(13), 44, 0.002) }], [{ f: S(13), cInf: 6, focus: foc([-0.9, 0.5, 0.8]) }]);
// 14 the taxi version: the cat steps out, the taxi comes up the road -> cut to the agent as it passes
def(14, [{ f: S(14), s: D([2.4, 0.75, 0.5], [-0.9, 0.6, 0.4], S(14), 44, 0.002) }, X(F(C.taxi) - 2, D([-1.25, 1.55, 6.6], [-1.4, 1.35, 2.6], F(C.taxi), 42, 0.002, { roll: 0.03 }, 0.006))],
  [{ f: S(14), cInf: 5, focus: foc([-0.9, 0.4, 0.3]) }, { f: F(C.taxi) - 2, cInf: 6, focus: foc([-1.4, 1.4, 2.6]) }]);
KICKS.push([C.taxi + 0.03, 1.0]);
// 15 the happy-life version
def(15, [{ f: S(15), s: D([-1.25, 0.95, 1.6], [-1.6, 0.6, -1.2], S(15), 46, 0.0018) }], [{ f: S(15), cInf: 5, focus: foc([-1.3, 0.6, -1.2]) }]);
// 16 it never spied on anyone
def(16, [{ f: S(16), s: D([-1.05, 0.42, 0.62], [-1.25, 0.27, -0.68], S(16), 40, 0.002) }], [{ f: S(16), cInf: 13, focus: foc([-1.2, 0.3, -0.68]) }]);
// 17 twenty million dollars
def(17, [{ f: S(17), s: D([0.6, 1.4, 4.8], [0.3, 0.9, 0.4], S(17), 46, 0.002) }, X(F(C.twenty) - 2, D([0.25, 1.2, 2.3], [0.05, 1.0, 0.6], F(C.twenty), 42, 0.003, {}, 0.006))],
  [{ f: S(17), cInf: 4, focus: foc([0.2, 0.9, 0.6]) }, { f: F(C.twenty) - 2, cInf: 10, focus: foc([0.05, 1.0, 0.6]) }]);
// 18 shut it down
def(18, [{ f: S(18), s: D([0.4, 1.55, 2.4], [0.1, 1.25, -2.0], S(18), 42, 0.0022) }], [{ f: S(18), cInf: 6, focus: foc([0.1, 1.3, -2.2]) }]);
KICKS.push([C.shut, 0.7]);
// 19 the memo
def(19, [{ f: S(19), s: D([0.03, 1.3, -0.15], [0, 1.3, -1.45], S(19), 40, 0.0018) }], [{ f: S(19), cInf: 8, focus: foc([0, 1.3, -1.45]) }]);
KICKS.push([C.practical, 0.8]);
// 20 every cat owner knows
def(20, [{ f: S(20), s: D([0.3, 1.4, 1.9], [0.25, 1.15, -1.8], S(20), 42, 0.0022) }], [{ f: S(20), cInf: 6, focus: foc([0.5, 1.1, -1.6]) }]);
KICKS.push([C.knows + 0.3 + Math.sqrt(0.75 / 4.9), 0.5]);
// 21 you can't tell a cat what to do
def(21, [{ f: S(21), s: D([0.3, 1.4, 1.9], [0.2, 1.2, -1.8], S(21), 42, 0.0025) }], [{ f: S(21), cInf: 6, focus: foc([0.4, 1.1, -1.6]) }]);

export const camAt = (id: number, f: number): Cam => applyKick(runKeys(CAMS[id], f), f / FPS);
export const dofAt = (id: number, f: number) => {
  const L = DOF[id];
  let i = 0; while (i + 1 < L.length && f >= L[i + 1].f) i++;
  const d = L[i], p = L[Math.max(0, i - 1)];
  const k = d.dur ? glide((f - d.f) / d.dur) : 1;
  return { cInf: p.cInf + (d.cInf - p.cInf) * k, focus: d.focus };
};
